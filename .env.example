# =============================================================================
# Team Health Check Environment Variables
# Copy this file to .env and update with your values
# =============================================================================

# Database connection (REQUIRED)
# Format: postgres://[user]:[password]@[host]:[port]/[database]?sslmode=[mode]
# SSL modes: disable (dev only), require, verify-ca, verify-full (recommended)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/teams360?sslmode=disable

# API Configuration
API_PORT=8080
GIN_MODE=release  # Options: debug, release

# Organization sync mass-deletion guard (OPTIONAL fallback)
# Max percentage of currently-synced, non-protected users/teams that a single
# sync run may delete before it is held for admin review.
# Precedence: the threshold an administrator saves in Admin > Settings wins;
# this variable applies only while none is saved; 20 applies if neither is set.
ORG_SYNC_MAX_DELETE_PERCENT=20

# Frontend Configuration
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080
# Documentation link shown in the app nav. Defaults to the locally-built MkDocs
# site served from frontend/public/docs (see `make docs-build`).
NEXT_PUBLIC_DOCS_URL=/docs/

# Email safety switches. For local testing set EMAIL_MODE=log: NO email is sent
# (SES/SMTP below are ignored) and each one is written to the backend log
# instead. Leave it blank for normal delivery. Any other value disables email.
EMAIL_MODE=
# Limit survey reminders to this one pod's team lead and members, whatever the
# mode. Match is by pod name, case-insensitive; an unknown name sends nothing.
EMAIL_TEST_POD=
# Deliver survey reminders to THESE addresses instead of their real recipients
# (comma separated), so you can test real delivery with coworkers. The real
# recipient never receives the email; the email itself is sent unchanged, and the intended recipient is only written to the server log.
# Other emails (survey notifications, password reset) are not sent in this mode.
# An entry that is not a plain email address disables email entirely.
EMAIL_REDIRECT_TO=

# Email — AWS SES (preferred, leave blank to fall back to SMTP or disable)
AWS_SES_REGION=
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
SES_FROM_ADDRESS=noreply@teams360.example.com

# Email — SMTP (fallback if SES is not configured, leave blank to disable)
# Keep SMTP_PASSWORD blank in this file. Set it in your own shell instead, so it is never
# written to disk or committed:  read -s -p "Password: " SMTP_PASSWORD; export SMTP_PASSWORD
# Typical settings:  Gmail      smtp.gmail.com, port 587, an app password (2-Step Verification on)
#                    Microsoft  smtp.office365.com, port 587, SMTP AUTH enabled for the mailbox
# SMTP_FROM must be an address this account is allowed to send as. Port 465 uses implicit TLS;
# any other port uses STARTTLS when the server offers it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@teams360.example.com

# Data Provider API (leave blank to disable)
DATA_PROVIDER_BASE_URL=
DATA_PROVIDER_API_TOKEN=

# Docker Image Version (for docker-compose)
VERSION=latest
